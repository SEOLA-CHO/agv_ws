<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="axel_agv">
  <material name="body_color">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <material name="lidar_color">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.130" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.700 0.560 0.210"/>
      </geometry>
      <material name="body_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.700 0.560 0.210"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_laser_frame" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="-0.230 0.0 0.255" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.050"/>
      </geometry>
      <material name="lidar_color"/>
    </visual>
  </link>
</robot>
